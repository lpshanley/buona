{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://buona.dev/schemas/config.schema.json",
  "title": "Buona Config",
  "description": "Global configuration for buona (~/.config/buona/config.json).",
  "type": "object",
  "required": ["workspace_dir"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "workspace_dir": {
      "type": "string",
      "description": "Root directory where workspaces are stored. Supports ~ for the home directory.",
      "default": "~/workspace"
    },
    "ide": {
      "type": "string",
      "description": "The user's preferred IDE.",
      "enum": ["vscode", "cursor", "windsurf"],
      "default": "vscode"
    },
    "git": {
      "type": "object",
      "description": "Default git settings.",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "description": "The git host (e.g. \"github.com\" or a GitHub Enterprise host).",
          "default": "github.com"
        },
        "organization": {
          "type": "string",
          "description": "The default organization on the host (e.g. \"my-org\").",
          "default": ""
        },
        "protocol": {
          "type": "string",
          "description": "The protocol used to clone and push.",
          "enum": ["ssh", "https"],
          "default": "ssh"
        }
      }
    }
  }
}
